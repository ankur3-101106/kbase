# Auto detect text files and perform LF normalization on checkout/commit
* text=auto eol=lf

# Explicit text file types
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Explicit binary files (do not touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
